{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "id": { "type": "string" },
    "evidenceType": { "type": "string" },
    "name": { "type": ["string", "null"] },
    "status": {
      "type": "string",
      "enum": ["COMPLIANT", "NONCOMPLIANT", "NOT_APPLICABLE", "UNKNOWN"]
    },
    "timestamp": { "type": "string" },
    "region": { "type": ["string", "null"] },
    "compartmentId": { "type": ["string", "null"] },
    "osClassification": { "type": ["string", "null"] },
    "hasPublicAddress": { "type": ["boolean", "null"] },
    "exposedAdministrativePorts": {
      "type": "array",
      "items": { "type": "number" }
    }
  }
}
