{
  "description": "Fails a KMS key with auto-rotation disabled. Mirrors AWS 'CMK Rotation' / Azure 'Key Vault Key Expiration'.",
  "evidenceType": "kms_key",
  "filteringCriteria": {
    "mode": "exclusion",
    "evaluator": { "all": [ { "fact": "evidenceType", "operator": "notEqual", "value": "kms_key" } ] }
  },
  "evaluator": {
    "all": [ { "fact": "autoRotationEnabled", "operator": "equal", "value": true } ]
  }
}
